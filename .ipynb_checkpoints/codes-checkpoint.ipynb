   "source": [
    "d = 4\n",
    "q = 2^d\n",
    "K = GF(q, name='ξ')\n",
    "R = PolynomialRing(K, name='w')\n",
    "w = R.gen()\n",
    "ξ = K.gen()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "0eeafeb5",
   "metadata": {
    "vscode": {
     "languageId": "julia"
    }
   },
   "outputs": [],
   "source": [
    "n = q-1\n",
    "g = (w^n - 1)/(w-1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "c03b980c",
   "metadata": {
    "vscode": {
     "languageId": "julia"
    }
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(w + ξ) * (w + ξ + 1) * (w + ξ^2) * (w + ξ^2 + 1) * (w + ξ^2 + ξ) * (w + ξ^2 + ξ + 1) * (w + ξ^3) * (w + ξ^3 + 1) * (w + ξ^3 + ξ) * (w + ξ^3 + ξ + 1) * (w + ξ^3 + ξ^2) * (w + ξ^3 + ξ^2 + 1) * (w + ξ^3 + ξ^2 + ξ) * (w + ξ^3 + ξ^2 + ξ + 1)"
      ]
     },
     "execution_count": 7,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "factor(g)"
   ]
  }
 ],
