    {
      "id": "Hbol",
      "code_hash": "df12445891b47c220d7a5c4966a3a303",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"source\">Source</h2>\n<span class=\"paragraph\">Based on the paper \"High-Throughput Semi-Honest Secure Three-Party Computation with an Honest Majority\", Toshinori Araki et al. CCS'16\nThe implementation uses a circuit describing a symmetric cypher with a sponge construction in which every permutation is derived, via a Feistel strucure, from two pseudo-randomly generated sboxes. Thus every party  can build the same circuit from a common random key.</span></span>"
          }
        }
      ],
      "console": []
    },
